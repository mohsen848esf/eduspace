# Created automatically by: bash scripts/server.sh init staging
# Server-only file. Never copy backend/.env here and never commit real secrets.
DEPLOY_ENV=staging
APP_DOMAIN=staging.example.com
RTC_DOMAIN=rtc-staging.example.com
PUBLIC_IP=203.0.113.10
# caddy: this project owns 80/443; external: use the existing host reverse proxy.
EDGE_MODE=caddy
WEB_PORT=8080
RTC_HTTP_PORT=7880
RTC_TCP_PORT=7881
RTC_UDP_PORT=7882
TURN_UDP_PORT=3478
SECRET_KEY=GENERATED_BY_INIT
DB_NAME=eduspace
DB_USER=edu
DB_PASSWORD=GENERATED_BY_INIT
LIVEKIT_API_KEY=GENERATED_BY_INIT
LIVEKIT_API_SECRET=GENERATED_BY_INIT
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.6
EGRESS_IMAGE=livekit/egress:v1.14.1

# Optional tuning. Defaults below work without an external storage/mail account.
RECORDING_DEFAULT_QUALITY=720p
RECORDING_MAX_DURATION_SECONDS=14400
PRESENTATION_MAX_UPLOAD_BYTES=52428800
PRESENTATION_MAX_OUTPUT_BYTES=104857600
PRESENTATION_MAX_PAGES=300
PRESENTATION_MAX_IMAGE_PIXELS=40000000
PRESENTATION_CONVERSION_TIMEOUT_SECONDS=120
S3_ENABLED=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
CDN_URL=
SENTRY_DSN=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Staging forces console email and disables outgoing Stripe/Twilio credentials.
# VITE_* settings are intentionally absent: frontend uses the current origin.
