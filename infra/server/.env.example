# Copy to .deploy/production.env and replace every placeholder before deployment.
# Server-only file. Never copy backend/.env here and never commit real secrets.
DEPLOY_ENV=production
APP_DOMAIN=app.example.com
RTC_DOMAIN=rtc.example.com
PUBLIC_IP=203.0.113.10
# caddy: this project owns 80/443; external: use the existing host reverse proxy.
EDGE_MODE=external
WEB_PORT=8081
RTC_HTTP_PORT=7890
RTC_TCP_PORT=7881
RTC_UDP_PORT=7882
TURN_UDP_PORT=3478
BACKEND_IMAGE=ghcr.io/mohsen848esf/eduspace-backend
WEB_IMAGE=ghcr.io/mohsen848esf/eduspace-web
RELEASE_TAG=production
SECRET_KEY=GENERATED_BY_INIT
DB_NAME=eduspace
DB_USER=edu
DB_PASSWORD=GENERATED_BY_INIT
LIVEKIT_API_KEY=GENERATED_BY_INIT
LIVEKIT_API_SECRET=GENERATED_BY_INIT
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.6
EGRESS_IMAGE=livekit/egress:v1.14.1

# Optional tuning. Recording can run without object storage, but the shared
# media library (upload, HLS delivery, and progressive ingest) cannot. Set
# these values to an AWS S3, Cloudflare R2, or another S3-compatible bucket.
RECORDING_DEFAULT_QUALITY=720p
RECORDING_MAX_DURATION_SECONDS=14400
PRESENTATION_MAX_UPLOAD_BYTES=52428800
PRESENTATION_MAX_OUTPUT_BYTES=104857600
PRESENTATION_MAX_PAGES=300
PRESENTATION_MAX_IMAGE_PIXELS=40000000
PRESENTATION_CONVERSION_TIMEOUT_SECONDS=120
S3_ENABLED=True
AWS_ACCESS_KEY_ID=REPLACE_WITH_OBJECT_STORAGE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_OBJECT_STORAGE_SECRET_KEY
AWS_STORAGE_BUCKET_NAME=REPLACE_WITH_MEDIA_BUCKET
# Leave blank for AWS S3. For R2/MinIO, use the provider's HTTPS endpoint.
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=auto
# Enable only after the media worker and FFmpeg runtime are verified.
MEDIA_PROGRESSIVE_UPLOAD_ENABLED=False
MEDIA_PROGRESSIVE_INGEST_ENABLED=False
CDN_URL=
SENTRY_DSN=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The application sends no real email while the console backend is selected.
# VITE_* settings are intentionally absent: frontend uses the current origin.
