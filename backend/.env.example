# Copy to backend/.env and fill in real values for production.

# Django
SECRET_KEY=replace-with-a-50+-character-random-string
DEBUG=True

# Database (Postgres)
DB_NAME=eduspace
DB_USER=edu
DB_PASSWORD=edupass123
DB_HOST=localhost
DB_PORT=5432

# Channels / cache
REDIS_HOST=localhost

# Local shared-media object storage (`docker compose up -d minio minio-init media-worker`)
S3_ENABLED=True
AWS_ACCESS_KEY_ID=eduspace
AWS_SECRET_ACCESS_KEY=eduspace-local-minio-secret
AWS_STORAGE_BUCKET_NAME=eduspace-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
MEDIA_PROGRESSIVE_UPLOAD_ENABLED=False
MEDIA_PROGRESSIVE_CHUNK_SIZE_BYTES=8388608
MEDIA_PROGRESSIVE_PREFIX_PROBE_BYTES=2097152
MEDIA_PROGRESSIVE_MIN_PLAYABLE_SECONDS=12
MEDIA_PROGRESSIVE_INGEST_ENABLED=False
MEDIA_PLAYBACK_OBJECT_URL_TTL_SECONDS=1200
MEDIA_PLAYBACK_DIRECT_OBJECT_URLS=False
MEDIA_PROGRESSIVE_INGEST_POLL_SECONDS=0.5
MEDIA_PROGRESSIVE_INGEST_TIMEOUT_SECONDS=18000
MEDIA_PROGRESSIVE_INGEST_LEASE_SECONDS=30
MEDIA_PROGRESSIVE_SEEK_GUARD_MS=8000

# LiveKit
# Local dev uses the docker-compose stack with the keys below. For production
# generate a strong api secret (>= 32 chars random) and rotate it periodically.
# When the Django process is on the host (not in docker), LIVEKIT_HOST_URL
# stays as http://localhost:7880. From inside docker-compose it would be
# http://livekit:7880.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=eduspace-local-livekit-secret-change-before-production
LIVEKIT_HOST_URL=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880

# Recording defaults
# 720p (default) | 1080p
RECORDING_DEFAULT_QUALITY=720p
# Where the egress worker writes MP4 files (mounted as /out in docker).
# Must match the bind mount in docker-compose.yml.
RECORDING_OUTPUT_DIR=media/recordings
# Hard upper bound for stored recordings per host (defense in depth).
RECORDING_MAX_DURATION_SECONDS=14400
